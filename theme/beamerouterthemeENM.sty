% ----------------------------------------------------------------------------
% *** required packages <<<
% ----------------------------------------------------------------------------
\RequirePackage{calc}
\RequirePackage{ifthen}
\RequirePackage{tikz}
\RequirePackage{epstopdf}

% ----------------------------------------------------------------------------
% *** END required packages >>>
% ----------------------------------------------------------------------------

\mode<presentation>

% ============================================================================
% *** FOOTER VISIBILITY OPTIONS <<<
% ============================================================================
% Toggle to show/hide entire footer
\newif\ifshowfootline
\showfootlinetrue  % Default: show footer

% Toggle to show/hide short field names on bottom left
\newif\ifshowfootlineleft
\showfootlinelefttrue  % Default: show left information

% Toggle to show/hide slide numbering
\newif\ifshowframenumber
\showframenumbertrue  % Default: show frame numbers

% Commands for users to control footer visibility
\newcommand{\hidefooter}{\showfootlinefalse}
\newcommand{\showfooter}{\showfootlinetrue}
\newcommand{\hidefooterleft}{\showfootlineleftfalse}
\newcommand{\showfooterleft}{\showfootlinelefttrue}
\newcommand{\hideframenumber}{\showframenumberfalse}
\newcommand{\showframenumber}{\showframenumbertrue}
% ============================================================================
% *** END FOOTER VISIBILITY OPTIONS >>>
% ============================================================================

% ============================================================================
% *** HEADLINE VISIBILITY OPTIONS <<<
% ============================================================================
% Toggle to show/hide headline logos
\newif\ifshowheadline
\showheadlinetrue  % Default: show headline

% Commands for users to control headline visibility
\newcommand{\hideheadline}{\showheadlinefalse}
\newcommand{\showheadline}{\showheadlinetrue}
% ============================================================================
% *** END HEADLINE VISIBILITY OPTIONS >>>
% ============================================================================

% ----------------------------------------------------------------------------
% *** DEFINE LENGTHS <<<
% ----------------------------------------------------------------------------
\newlength{\margin}
\setlength{\margin}{0.8832cm}

\newlength{\ulogowidth}
\setlength{\ulogowidth}{1.1136cm}
\newlength{\ulogoheight}
\setlength{\ulogoheight}{0.90066895151709692cm}
\newlength{\ulogopadding}
\setlength{\ulogopadding}{0.2784cm}
% ----------------------------------------------------------------------------
% *** END DEFINE LENGTHS >>>
% ----------------------------------------------------------------------------


% ----------------------------------------------------------------------------
% *** DEFINE IMAGES <<<
% ----------------------------------------------------------------------------
\pgfdeclareimage[width=2.5\ulogowidth]{ENMLogo}{Logos/enm-en-rgb}
\pgfdeclareimage[width=2.6\ulogowidth]{AntorLogo}{Logos/antor-logo}
\pgfdeclareimage[width=2.8\ulogowidth]{AntorDarkLogo}{Logos/antor-logo-dark}
\pgfdeclareimage[width=4.35\ulogowidth]{AntorLightLogo}{Logos/antor-logo-light}
\pgfdeclareimage[width=4.2\ulogowidth]{AntorGreenLogo}{Logos/antor-logo-green}
\pgfdeclareimage[width=2.8\ulogowidth]{AntorGreenLightLogo}{Logos/antor-logo-green-light}
\pgfdeclareimage[height=12mm]{uTextColor}{Logos/enm-en-white}
% ----------------------------------------------------------------------------
% *** END DEFINE IMAGES <<<
% ----------------------------------------------------------------------------


% ----------------------------------------------------------------------------
% *** HEADLINE <<<
% ----------------------------------------------------------------------------
\newlength{\logotopmargin}%
\setlength{\logotopmargin}{0.704cm}%
\defbeamertemplate*{headline}{ua theme}%
{%
	\ifshowheadline
		\ifnum\c@framenumber=1\else
			\ifnum\c@framenumber=\inserttotalframenumber\else
				\vskip\logotopmargin%
				\hfill%
				\ifuseantorlogo
					\ifuseantorclassic
						\pgfuseimage{AntorLogo}
					\else
						\ifENMlighttheme
							\pgfuseimage{AntorGreenLightLogo}
						\else
							\pgfuseimage{AntorDarkLogo}
						\fi
					\fi
				\else
					\pgfuseimage{ENMLogo}
				\fi
				\hspace{0.5cm}
			\fi\fi
	\fi
}
% ----------------------------------------------------------------------------
% *** END HEADLINE <<<
% ----------------------------------------------------------------------------


% ----------------------------------------------------------------------------
% *** FRAMETITLE <<<
% ----------------------------------------------------------------------------
\newlength\frametitletopmargin
\setlength{\frametitletopmargin}{-1.216cm}

\newlength{\frametitlewidth}
\setlength{\frametitlewidth}{\textwidth-\ulogowidth-\ulogopadding}

\defbeamertemplate*{frametitle}{ua theme}
{%
	\nointerlineskip%
	\vskip-\ulogoheight%
	\vskip0.104cm%
	\vbox to \ulogoheight{%
		\vfil%
		\rightskip=\ulogowidth%
		\advance\rightskip by\ulogopadding%
		\begin{beamercolorbox}[rightskip=\rightskip]{frame title}%
			\insertframetitle\par%
		\end{beamercolorbox}%
		\ifx\insertframesubtitle\@empty\else%
			\vskip-1ex%
			\begin{beamercolorbox}[rightskip=\rightskip]{framesubtitle}%
				\usebeamerfont{framesubtitle}\insertframesubtitle\par%
			\end{beamercolorbox}%
		\fi%
		\vfil%
	}%
}
% ----------------------------------------------------------------------------
% *** END FRAMETITLE >>>
% ----------------------------------------------------------------------------


% ----------------------------------------------------------------------------
% *** FOOTLINE <<<
% ----------------------------------------------------------------------------
\newlength{\textlogobottommarginDark}
\setlength{\textlogobottommarginDark}{6.8cm}
\newcommand\uTextColorPosDark {\pgfpoint{0.5\paperwidth}{\textlogobottommarginDark}}

% - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
\defbeamertemplate*{footline}{ua theme}
{%
	\ifshowfootline
		\ifnum\c@framenumber=1
			%
		\else
			\ifnum\c@framenumber=\inserttotalframenumber
				%
			\else
				\ifshowfootlineleft
					\pgftext[left,bottom,at=\pgfpoint{0.05\paperwidth}{0.02\paperwidth}]{%
						\usebeamerfont{frame number in foot}%
						\tiny
						\usebeamercolor[fg]{frame number in foot}%
						\ifx\insertshortauthor\@empty\else
							\insertshortauthor
						\fi%
						\ifx\insertshortdate\@empty\else
							\ifx\insertshortauthor\@empty\else
								\space\textbar\space
							\fi
							\insertshortdate
						\fi%
						\ifx\insertshortvent\@empty\else
							\ifx\insertshortauthor\@empty
								\ifx\insertshortdate\@empty\else
									\space\textbar\space
								\fi
							\else
								\space\textbar\space
							\fi
							\insertshortvent
						\fi%
					}%
				\fi
				\ifshowframenumber
					\pgftext[right,bottom,at=\pgfpoint{0.95\paperwidth}{0.02\paperwidth}]{%
						\usebeamerfont{frame number in foot}%
						\usebeamercolor[fg]{frame number in foot}\insertframenumber/\inserttotalframenumber%
					}%
				\fi
			\fi
		\fi
	\fi
}%
% ----------------------------------------------------------------------------
% *** END of FOOTLINE >>>
% ----------------------------------------------------------------------------


% ----------------------------------------------------------------------------
% *** MARGINS <<<
% ----------------------------------------------------------------------------
\setbeamersize{text margin left=\margin,%
	text margin right=\margin}
% ----------------------------------------------------------------------------
% *** END MARGINS >>>
% ----------------------------------------------------------------------------


% ----------------------------------------------------------------------------
% *** BACKGROUND <<<
% ----------------------------------------------------------------------------
\defbeamertemplate*{background canvas}{ua theme}
{%
	\ifnum\c@framenumber=1%
		\begin{tikzpicture}
			\useasboundingbox (0,0) rectangle (\the\paperwidth,\the\paperheight);
			\ifENMlighttheme
				\fill[color={rgb,255:red,103;green,167;blue,49}] (0,0) rectangle (\the\paperwidth,\the\paperheight);
			\else
				\fill[color={rgb,255:red,15;green,45;blue,100}] (0,0) rectangle (\the\paperwidth,\the\paperheight);
			\fi
		\end{tikzpicture}
	\else%
		\ifnum\c@framenumber=\inserttotalframenumber%
			\begin{tikzpicture}
				\useasboundingbox (0,0) rectangle (\the\paperwidth,\the\paperheight);
				\ifENMlighttheme
					\fill[color={rgb,255:red,153;green,197;blue,99}] (0,0) rectangle (\the\paperwidth,\the\paperheight);
				\else
					\fill[color={rgb,255:red,87;green,108;blue,150}] (0,0) rectangle (\the\paperwidth,\the\paperheight);
				\fi
			\end{tikzpicture}
		\fi%
	\fi%
}
% ----------------------------------------------------------------------------
% *** END BACKGROUND <<<
% ----------------------------------------------------------------------------

\mode <all>
