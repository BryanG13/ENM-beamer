\mode<presentation>

% =========================================================================
% ENM Colors
\definecolor{enmblue}{RGB}{0,43,61}
\colorlet{enmblue100}{enmblue}
\colorlet{enmblue75} {enmblue!75!white}
\colorlet{enmblue50} {enmblue!50!white}
\colorlet{enmblue25} {enmblue!25!white}
\colorlet{enmblue10} {enmblue!10!white}
\colorlet{enmblue5}  {enmblue!5!white}

\definecolor{enmgoldlight}{RGB}{103,167,49}
\definecolor{enmgold}{RGB}{103,167,49}
\colorlet{enmgold100}{enmgold}
\colorlet{enmgold75} {enmgold!75!white}
\colorlet{enmgold50} {enmgold!50!white}
\colorlet{enmgold25} {enmgold!25!white}
\colorlet{enmgold10} {enmgold!10!white}
\colorlet{enmgold5}  {enmgold!5!white}

\definecolor{darkgreen}{RGB}{0,100,0}
\colorlet{darkgreen100}{darkgreen}
\colorlet{darkgreen75}{darkgreen!75!white}
\colorlet{darkgreen50}{darkgreen!50!white}
% =========================================================================

% Accent color — matches background theme
\definecolor{enmaccent}{RGB}{15,45,100}
\colorlet{enmaccent100}{enmaccent}
\colorlet{enmaccent75}{enmaccent!75!white}
\colorlet{enmaccent50}{enmaccent!50!white}
\colorlet{enmaccent10}{enmaccent!10!white}

% Block accent color
\definecolor{blockaccent}{RGB}{103,167,49}
\colorlet{blockaccent100}{blockaccent}
\colorlet{blockaccent75}{blockaccent!75!white}
\colorlet{blockaccent50}{blockaccent!50!white}
\colorlet{blockaccent10}{blockaccent!10!white}

% Gray colors for blocks
\definecolor{blockgray}{RGB}{210,210,210}
\definecolor{blockgraybody}{RGB}{240,240,240}

\setbeamercolor{structure}{fg=enmblue}%
\setbeamercolor{normal text}{fg=black}%
\setbeamercolor{frametitle}{fg=enmaccent}%
\setbeamercolor{framesubtitle}{fg=enmaccent75}%
\setbeamercolor{frame number in foot}{fg=lightgray}%
\setbeamercolor{title}{fg=white}%
\setbeamercolor{subtitle}{fg=white}%
\setbeamercolor{author}{fg=white}%
\setbeamercolor{institute}{fg=white}%
\setbeamercolor{date}{fg=white}%

% =======================================================================
% alert color
\setbeamercolor{alerted text}{fg=enmgold}
% =======================================================================

% =======================================================================
% blocks
\setbeamercolor{block title}{fg=black,bg=blockgray}
\setbeamercolor{block title alerted}{use=alerted text,fg=white,bg=blockaccent}
\setbeamercolor{block title example}{use=example text,fg=white,bg=enmaccent}

\setbeamercolor{block body}{fg=enmaccent100,bg=blockgraybody}
\setbeamercolor{block body alerted}{fg=enmaccent100,use=block title alerted,bg=blockaccent10}
\setbeamercolor{block body example}{fg=enmaccent,use=block title example,bg=enmaccent10}
% =======================================================================

% =======================================================================
% numbering color
\setbeamercolor{section number projected}{bg=enmgold75,fg=enmblue}
% =======================================================================

\setbeamercolor{itemize item}{fg=enmaccent100}
\setbeamercolor{itemize subitem}{fg=enmaccent75}
\setbeamercolor{itemize subsubitem}{fg=enmaccent50}

\mode
<all>
