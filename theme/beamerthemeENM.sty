\mode<presentation>

% ============================================================================
% *** THEME MODE OPTIONS <<<
% ============================================================================
\newif\ifENMlighttheme
\ENMlightthemefalse  % Default: dark theme

\newif\ifuseantorlogo
\useantorlogofalse  % Default: use ENM logo

\newif\ifuseantordarklogo
\useantordarklogofalse  % Default: use regular antor logo

\DeclareOptionBeamer{light}{\ENMlightthemetrue}
\DeclareOptionBeamer{dark}{\ENMlightthemefalse}
\DeclareOptionBeamer{antor}{\useantorlogotrue}
\DeclareOptionBeamer{antorDark}{\useantordarklogotrue}
\ProcessOptionsBeamer
% ============================================================================
% *** END THEME MODE OPTIONS >>>
% ============================================================================

\useinnertheme{ENM}
\usefonttheme{ENM}
\usecolortheme{ENM}
\useoutertheme{ENM}

\mode
<all>
