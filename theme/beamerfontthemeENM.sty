\mode<presentation>

\setbeamerfont{title}     {size=\huge}
\setbeamerfont{subtitle}  {size=\Large}
\setbeamerfont{frametitle}{size=\LARGE}
\setbeamerfont{framesubtitle}{size={\fontsize{12}{12}}}

\setbeamerfont{author}{size=\normalsize}
\setbeamerfont{institute}{size=\fontsize{8}{7.2}}
\setbeamerfont{date}{size=\fontsize{8}{7.2}}
\setbeamerfont{email}{size=\fontsize{8}{7.2}}

\setbeamerfont{frame number in foot}{size=\scriptsize}

\setbeamerfont{block title}{series=\bfseries,size={\fontsize{10}{12}}}
\setbeamerfont{block body}{size=\small}

% Math font configuration
\DeclareMathAlphabet{\mathbf}{OT1}{cmr}{bx}{n}

\mode
<all>
